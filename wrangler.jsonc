{
  // Cloudflare Workers 설정 — https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-less-eat-more",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // 비용을 줄이려면 "claude-haiku-5-5" 로 바꾸세요
    "CLAUDE_MODEL": "claude-opus-5-5"
  },
  // AI 추천 남용 방지: IP 당 1분에 10회
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true },
  // 내 도메인 연결: Cloudflare 에 등록된 도메인이면 아래 주석을 풀고 도메인을 바꾸세요
  // "routes": [{ "pattern": "lunch.example.com", "custom_domain": true }],
  "workers_dev": true
}
