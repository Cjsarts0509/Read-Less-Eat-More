{
  // Cloudflare Workers 설정 — https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunch-makes-the-person",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // 비용을 줄이려면 "claude-haiku-5-5" 로 바꾸세요
    "CLAUDE_MODEL": "claude-opus-5-5"
  },
  // AI 추천 남용 방지: IP 당 1분에 10회
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true },
  // 내 도메인: cjslabs.kr 존이 Cloudflare 에 있어야 하고, 같은 이름의 기존 DNS 레코드가 없어야 한다.
  // 이미 다른 사이트가 쓰고 있다면 "lunch.cjslabs.kr" 처럼 서브도메인으로 바꾸세요.
  "routes": [{ "pattern": "cjslabs.kr", "custom_domain": true }],
  "workers_dev": true
}
