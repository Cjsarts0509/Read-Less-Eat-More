{
  // Cloudflare Workers 설정 — https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunch-makes-the-person",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // 비용을 줄이려면 "claude-haiku-5-5" 로 바꾸세요
    "CLAUDE_MODEL": "claude-opus-5-5",
    // 팀 투표방 · 메뉴판 사진 · 날씨(env_forecast) 를 읽고 쓰는 Supabase. 키는 시크릿 SUPABASE_SECRET_KEY 로
    "SUPABASE_URL": "https://owakkzcksskilgzamvnq.supabase.co"
  },
  // AI 호출 남용 방지: IP · 기능마다 1분에 10회
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true },
  // 내 도메인은 여기 적지 않고 GitHub 저장소 변수 CUSTOM_DOMAIN(예: cjslabs.kr)으로 붙인다 (deploy.yml 의 --domain).
  // 도메인이 Cloudflare 에 등록되기 전에도 workers.dev 주소로는 배포되게 하려는 것.
  "workers_dev": true
}
